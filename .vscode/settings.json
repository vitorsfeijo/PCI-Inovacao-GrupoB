{
  // Ferramenta: chama o pdflatex direto, sem latexmk (não precisa de Perl)
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    }
  ],

  // Receita: roda o pdflatex duas vezes (a 2ª acerta sumário e referências)
  "latex-workshop.latex.recipes": [
    {
      "name": "pdfLaTeX (2x)",
      "tools": ["pdflatex", "pdflatex"]
    }
  ],
  "latex-workshop.latex.recipe.default": "first",

  // Compila ao salvar e abre o PDF numa aba do VS Code
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.view.pdf.viewer": "tab"
}